+export function arcMeasuredResponseColumn(origin:number[],probes:Array<{step:number;residuals:number[]}|null>):number[]{
+  // Fit changes through the measured origin. Clipped or one-sided probes must
+  // use their actual normalized displacement rather than an assumed unit step.
+  const useful=probes.filter((p):p is {step:number;residuals:number[]}=>!!p&&Math.abs(p.step)>1e-9);
+  const mass=useful.reduce((sum,p)=>sum+p.step*p.step,0);
+  return origin.map((value,r)=>mass?useful.reduce((sum,p)=>sum+p.step*(p.residuals[r]-value),0)/mass:0);
+}
