@@ -27,11 +27,22 @@ export function arcControlProposals(features:number[],incoming:number,span:numbe
     return model.models.flatMap((m:any,j:number)=>counts[j]?arcControlProposals(features,incoming,span,m,counts[j]):[]);
   }
   if(model.exemplars){
