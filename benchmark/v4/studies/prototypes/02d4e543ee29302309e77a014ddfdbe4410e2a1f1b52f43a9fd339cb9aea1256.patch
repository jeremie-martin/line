+/** Corrections informed by measured arc errors, always followed by simulation. */
+import type {ArcMotionControl} from './arc_geometry.ts';
+export function arcCorrectionControlVector(c:ArcMotionControl,incoming:number,span:number,channel=12):number[]{
+  return [(c.entry-incoming)/30,c.turn/60,(c.exit-incoming)/60,c.support/span,c.bias,c.offset,
+    (c.clearance??channel)/12,c.turnFraction??Math.min(5,c.support*.5)/c.support,
+    (c.bend??0)/30,(c.guideFlare??0)/8];
+}
+
+export function arcMeasuredCorrections(context:number[],control:ArcMotionControl,residuals:number[],
+  incoming:number,span:number,model:any,count:number,channel=12):ArcMotionControl[]{
+  if(context.length!==63||residuals.length!==4||!Number.isSafeInteger(count)||count<0)throw new Error('invalid measured arc correction request');
+  const measured=model.featureSchema==='line.arc-measured-control-correction-features.v1';
+  if(!measured&&model.featureSchema!=='line.arc-context-control-correction-features.v1')throw new Error('arc correction feature schema mismatch');
+  const encoded=arcCorrectionControlVector(control,incoming,span,channel);
+  const features=[...context,...encoded,...(measured?residuals:[])];
+  if(features.length!==model.featureCount||features.some(v=>!Number.isFinite(v)))throw new Error('arc correction features mismatch');
+  if(!count)return [];
+  const input=features.map(Math.fround);
+  const leaves:number[][]=model.trees.map((tree:any)=>{
+    let n=0;while(tree.left[n]>=0)n=input[tree.feature[n]]<=tree.threshold[n]?tree.left[n]:tree.right[n];
+    return tree.value[n];
+  });
+  const mean=(rows:number[][])=>rows[0].map((_,j)=>rows.reduce((sum,row)=>sum+row[j],0)/rows.length);
+  const vectors=[mean(leaves),mean(leaves.filter((_,i)=>i%2===0)),mean(leaves.filter((_,i)=>i%2===1)),...leaves];
+  return vectors.slice(0,Math.ceil(count/3)).flatMap(delta=>[1,.5,.25].map(strength=>{
+    const v=encoded.map((value,i)=>value+strength*delta[i]);
+    return {...control,entry:incoming+30*v[0],turn:60*v[1],exit:incoming+60*v[2],support:span*v[3],
+      bias:v[4],offset:v[5],clearance:12*v[6],turnFraction:v[7],bend:30*v[8],guideFlare:8*v[9]};
+  })).slice(0,count);
+}
