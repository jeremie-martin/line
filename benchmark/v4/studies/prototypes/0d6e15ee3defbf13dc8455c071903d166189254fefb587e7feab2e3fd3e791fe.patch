+import {expect,it} from 'vitest';
+import {arcNetworkPrediction,arcNetworkCorrections,arcNetworkControlVector} from '../scripts/v0/optimizer/arc_response_network.ts';
+import {compileArcMotion} from '../scripts/v0/optimizer/arc_motion.ts';
+import type {Spec} from '../scripts/v0/types.ts';
+const model=(layers:any[])=>({featureSchema:'line.arc-response-network-features.v1',featureCount:73,
+  inputMean:Array(73).fill(0),inputScale:Array(73).fill(1),outputMean:Array(4).fill(0),outputScale:Array(4).fill(1),layers});
+const linear=model([{weights:Array.from({length:73},(_,i)=>Array.from({length:4},(_,j)=>i===63+j?1:0)),bias:Array(4).fill(0)}]);
+it('matches finite differences through multiple nonlinear layers',()=>{
+  const network=model([{weights:Array.from({length:73},(_,i)=>[Math.sin(i)*.02,Math.cos(i)*.03]),bias:[.1,-.2]},
+    {weights:[[.2,-.3],[.4,.1]],bias:[.1,.2]},
+    {weights:[[.2,.1,-.3,.4],[-.1,.2,.4,-.3]],bias:Array(4).fill(.1)}]);
+  const features=Array.from({length:73},(_,i)=>Math.sin(i));const actual=arcNetworkPrediction(features,network);
+  for(let j=0;j<10;j++){
+    const a=features.slice(),b=features.slice();a[63+j]+=1e-6;b[63+j]-=1e-6;
+    const plus=arcNetworkPrediction(a,network).residuals,minus=arcNetworkPrediction(b,network).residuals;
+    for(let r=0;r<4;r++)expect(actual.jacobian[r][j]).toBeCloseTo((plus[r]-minus[r])/2e-6,8);
+  }
+  expect(()=>arcNetworkPrediction(features.slice(1),network)).toThrow('feature mismatch');
+});
+it('reduces a calibrated model error with bounded coherent control changes',()=>{
+  const c={entry:22,turn:12,exit:30,support:15,bias:.2,offset:.1,clearance:13,turnFraction:.4,bend:3,guideFlare:2};
+  const context=Array(63).fill(.5),residuals=[.2,-.1,.03,.05],v=arcNetworkControlVector(c,20,30);
+  const proposals=arcNetworkCorrections(context,c,residuals,20,30,linear,6,{bidirectional:true,preserveTurnTiming:true});
+  expect(proposals.length).toBeGreaterThan(0);expect(proposals.length).toBeLessThanOrEqual(6);
+  const values=arcNetworkControlVector(proposals[0],20,30),after=residuals.map((r,j)=>r+values[j]-v[j]);
+  expect(after.reduce((sum,x)=>sum+x*x,0)).toBeLessThan(residuals.reduce((sum,x)=>sum+x*x,0));
+  expect(Math.abs(proposals[0].entry-c.entry)).toBeLessThanOrEqual(4+1e-10);
+  expect(proposals[0].support).toBeGreaterThanOrEqual(2);
+});
+it('validates network proposals through the engine inside the existing frame allowance',()=>{
+  const spec:Spec={duration:4,preroll:5,jitter:0,contacts:[.6,1.2,1.8,2.4,3,3.6].map(t=>({t,impact:.4})),axes:{air:()=>.5,speed:()=>.5}};
+  const tree={left:[-1],right:[-1],feature:[-2],threshold:[-2],value:[[0,0,0,.5,0,0,1,.4,0,0]]};
+  const policy={featureSchema:'line.arc-control-policy-features.v1',featureCount:57,trees:[tree,tree],responseNetwork:linear};
+  const options={budget:40000,samples:32,channel:12,radius:24,bidirectional:true,impactWeight:1,amplitudeWeight:1/3,
+    arrivalWeight:.3,headingWeight:.3,guidance:'clearance' as const,guidanceJoint:true,guidanceSamples:48,responseSamples:46,
+    expressive:true,policySamples:8,completeBoundary:true,controlPolicy:policy};
+  const plain=compileArcMotion(spec,17,options),disabled=compileArcMotion(spec,17,{...options,networkCorrectionSamples:0});
+  expect(disabled.track).toEqual(plain.track);expect(disabled.stats).toEqual(plain.stats);
+  const enabled=compileArcMotion(spec,17,{...options,networkCorrectionSamples:6});
+  expect(enabled.networkStats!.proposals).toBeGreaterThan(0);expect(enabled.networkStats!.physicsFrames).toBeGreaterThan(0);
+  expect(enabled.failure).toBeNull();expect(enabled.report.contacts.every(c=>c.status==='hit')).toBe(true);
+  expect(enabled.stats.sim_frames).toBeLessThanOrEqual(options.budget);expect(enabled.track.lines.every(l=>l.type===0)).toBe(true);
+});
