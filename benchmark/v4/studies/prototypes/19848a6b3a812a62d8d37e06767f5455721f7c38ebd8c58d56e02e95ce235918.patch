+import {expect,it} from 'vitest';
+import {arcResponseStep,arcBoxResponseStep} from '../scripts/v0/optimizer/arc_response.ts';
+import {compileArcMotion} from '../scripts/v0/optimizer/arc_motion.ts';
+import type {Spec} from '../scripts/v0/types.ts';
+const loss=(j:number[][],r:number[],x:number[],d:number)=>j.reduce((s,row,i)=>s+(r[i]+row.reduce((a,v,k)=>a+v*x[k],0))**2,0)+d*x.reduce((s,v)=>s+v*v,0);
+it('adjusts the other controls after one control reaches its limit',()=>{
+  const j=[[1,2],[0,1]],r=[-10,0],d=.01;
+  const clipped=arcResponseStep(j,r,d)!.map(v=>Math.max(-1,Math.min(1,v)));
+  const x=arcBoxResponseStep(j,r,d,1)!;
+  expect(x).toEqual([1,1]);expect(loss(j,r,x,d)).toBeLessThan(loss(j,r,clipped,d)-1);
+});
+it('satisfies constrained optimality and dominates independent clipping on varied coupled systems',()=>{
+  let seed=17;const random=()=>((seed=(1664525*seed+1013904223)>>>0)/2**32)*2-1;
+  for(let k=0;k<100;k++){
+    const j=Array.from({length:5},()=>Array.from({length:10},random)),r=Array.from({length:5},()=>random()*20),d=.0002;
+    const x=arcBoxResponseStep(j,r,d)!,clipped=arcResponseStep(j,r,d)!.map(v=>Math.max(-3,Math.min(3,v)));
+    expect(x.every(v=>v>=-3&&v<=3)).toBe(true);expect(loss(j,r,x,d)).toBeLessThanOrEqual(loss(j,r,clipped,d)+1e-9);
+    for(let i=0;i<x.length;i++){
+      const g=d*x[i]+j.reduce((s,row,a)=>s+row[i]*(r[a]+row.reduce((t,v,b)=>t+v*x[b],0)),0);
+      expect(x[i]>=3-1e-8?Math.max(0,g):x[i]<=-3+1e-8?Math.max(0,-g):Math.abs(g)).toBeLessThan(1e-7);
+    }
+  }
+});
+it('uses only valid normal arcs within the physical frame ceiling',()=>{
+  const spec:Spec={duration:4,preroll:5,jitter:0,contacts:[.6,1.2,1.8,2.4,3,3.6].map(t=>({t,impact:.4})),axes:{air:()=>.5,speed:()=>.5}};
+  const options={budget:40000,samples:32,channel:12,radius:24,bidirectional:true,impactWeight:1,amplitudeWeight:1/3,arrivalWeight:.3,headingWeight:.3,guidance:'clearance' as const,guidanceJoint:true,guidanceSamples:92,responseSamples:92,expressive:true,completeBoundary:true,boxResponse:true};
+  const r=compileArcMotion(spec,17,options);expect(r.failure).toBeNull();expect(r.report.contacts.every(c=>c.status==='hit')).toBe(true);expect(r.track.lines.every(l=>l.type===0)).toBe(true);expect(r.stats.sim_frames).toBeLessThanOrEqual(options.budget);
+  const low=compileArcMotion(spec,17,{...options,budget:6000});expect(low.stats.sim_frames).toBeLessThanOrEqual(6000);expect(low.searchBudgetExhausted).toBe(true);
+});
