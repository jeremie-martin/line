+/** Solve the same damped quadratic with a box on the joint step. The active-set
+ * iterations stay feasible and release a bound when its gradient points inward.
+ * Each accepted iterate improves the clipped unconstrained starting solution. */
+export function arcBoxResponseStep(jacobian:number[][],residuals:number[],damping:number,limit=3):number[]|null {
+  const initial=arcResponseStep(jacobian,residuals,damping);
+  if(!initial||!(damping>0)||!Number.isFinite(limit)||limit<=0)return null;
+  const n=initial.length,x=initial.map(v=>Math.max(-limit,Math.min(limit,v)));
+  const h=Array.from({length:n},(_,i)=>Array.from({length:n},(_,j)=>jacobian.reduce((s,row)=>s+row[i]*row[j],0)+(i===j?damping:0)));
+  const linear=Array.from({length:n},(_,i)=>jacobian.reduce((s,row,r)=>s+row[i]*residuals[r],0));
+  const active=x.map(v=>v===limit?1:v===-limit?-1:0);
+  const objective=(v:number[])=>v.reduce((s,a,i)=>s+linear[i]*a+.5*a*h[i].reduce((t,b,j)=>t+b*v[j],0),0);
+  let best=x.slice(),bestLoss=objective(x);
+  const solve=(a:number[][]):number[]|null=>{
+    const count=a.length;
+    for(let i=0;i<count;i++){
+      let pivot=i;for(let r=i+1;r<count;r++)if(Math.abs(a[r][i])>Math.abs(a[pivot][i]))pivot=r;
+      [a[i],a[pivot]]=[a[pivot],a[i]];const d=a[i][i];if(!Number.isFinite(d)||Math.abs(d)<1e-14)return null;
+      for(let c=i;c<=count;c++)a[i][c]/=d;
+      for(let r=0;r<count;r++)if(r!==i){const f=a[r][i];for(let c=i;c<=count;c++)a[r][c]-=f*a[i][c];}
+    }
+    const result=a.map(row=>row[count]);return result.every(Number.isFinite)?result:null;
+  };
+  for(let iteration=0;iteration<128;iteration++){
+    const gradient=linear.map((v,i)=>v+h[i].reduce((s,a,j)=>s+a*x[j],0));
+    const free=active.flatMap((v,i)=>v===0?[i]:[]);
+    const p=Array(n).fill(0),solved=solve(free.map(i=>[...free.map(j=>h[i][j]),-gradient[i]]));
+    if(!solved)return best;
+    free.forEach((i,k)=>p[i]=solved[k]);
+    if(Math.max(0,...p.map(Math.abs))<1e-10){
+      let release=-1,violation=1e-10;
+      for(let i=0;i<n;i++)if(active[i]&&gradient[i]*active[i]>violation){violation=gradient[i]*active[i];release=i;}
+      if(release<0)return x;
+      active[release]=0;continue;
+    }
+    let fraction=1,blocking=-1;
+    for(const i of free)if(Math.abs(p[i])>1e-14){
+      const allowed=((p[i]>0?limit:-limit)-x[i])/p[i];
+      if(allowed<fraction){fraction=Math.max(0,allowed);blocking=i;}
+    }
+    for(let i=0;i<n;i++)x[i]=Math.max(-limit,Math.min(limit,x[i]+fraction*p[i]));
+    if(blocking>=0){x[blocking]=p[blocking]>0?limit:-limit;active[blocking]=Math.sign(p[blocking]);}
+    const loss=objective(x);if(loss<bestLoss){bestLoss=loss;best=x.slice();}
+  }
+  return best;
+}
