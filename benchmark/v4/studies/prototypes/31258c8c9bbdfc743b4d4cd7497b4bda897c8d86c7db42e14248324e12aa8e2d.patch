diff --git a/tests/arc_physical_damping.test.ts b/tests/arc_physical_damping.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/arc_physical_damping.test.ts
@@ -0,0 +1,38 @@
+import {expect,it} from 'vitest';
+import {ArcControlMemory} from '../scripts/v0/optimizer/arc_memory.ts';
+import {compileArcMotion} from '../scripts/v0/optimizer/arc_motion.ts';
+import type {Spec} from '../scripts/v0/types.ts';
+
+it('keeps the same physical memory correction when only response coordinates change',()=>{
+  const features=Array(57).fill(0),control={entry:0,turn:0,exit:0,support:12,bias:0,offset:0};
+  const proposal=(trust:number,physicalDamping:boolean)=>{
+    const memory=new ArcControlMemory();
+    memory.rememberResponse({features,incoming:0,span:30,control,targets:[.5,.5,undefined,undefined],
+      keys:['entry','turn'],jac:[[2*trust,trust],[trust,3*trust],[0,0],[0,0]],
+      residuals:[.2,.15,0,0],scale:[2*trust,5*trust],loss:.0625,trust});
+    return memory.proposeResponses(features,0,30,[.5,.5,undefined,undefined],1,
+      {amplitude:1/3,impact:1,damping:.002,physicalDamping})[0];
+  };
+  const reference=proposal(1,true);
+  for(const trust of [.5,.25,.125]){
+    const actual=proposal(trust,true);
+    expect(actual.entry).toBeCloseTo(reference.entry,12);
+    expect(actual.turn).toBeCloseTo(reference.turn,12);
+  }
+  expect(Math.abs(proposal(.125,false).entry-reference.entry)).toBeGreaterThan(.0001);
+});
+
+it('preserves disabled behavior and validates fine corrections within the actual work limit',()=>{
+  const spec:Spec={duration:5,preroll:5,jitter:0,contacts:[.6,1.2,1.8,2.4,3,3.6,4.2].map(t=>({t,impact:.4})),axes:{air:()=>.5,speed:()=>.5,amplitude:()=>.2}};
+  const options={budget:100000,samples:80,channel:12,radius:24,bidirectional:true,
+    impactWeight:1,amplitudeWeight:1/3,arrivalWeight:.3,headingWeight:.3,authoredHorizon:true,
+    guidance:'clearance' as const,guidanceJoint:true,guidanceSamples:176,responseSamples:161,expressive:true,memoryResponseSamples:4};
+  const original=compileArcMotion(spec,17,options);
+  const disabled=compileArcMotion(spec,17,{...options,physicalResponseDamping:false,physicalMemoryDamping:false});
+  expect(disabled.track).toEqual(original.track);expect(disabled.stats).toEqual(original.stats);
+  const result=compileArcMotion(spec,17,{...options,physicalResponseDamping:true,physicalMemoryDamping:true});
+  expect(result.failure).toBeNull();expect(result.report.contacts.every(c=>c.status==='hit')).toBe(true);
+  expect(result.report.off_beat_landings).toEqual([]);expect(result.stats.sim_frames).toBeLessThanOrEqual(options.budget);
+  expect(result.responseDampingDiagnostics!.smallerRounds).toBeGreaterThan(0);
+  expect(result.responseDampingDiagnostics!.smallerImprovements).toBeGreaterThan(0);
+});
