+++ b/tests/arc_proposal_ranker.test.ts
@@ -0,0 +1,39 @@
+import {expect,it} from 'vitest';
+import {arcProposalControlFeatures,arcProposalQuality,rankArcControlProposals,ARC_PROPOSAL_FEATURE_SCHEMA} from '../scripts/v0/optimizer/arc_proposal_ranker.ts';
+import {compileArcMotion} from '../scripts/v0/optimizer/arc_motion.ts';
+import {ARC_POLICY_SCHEMA} from '../scripts/v0/optimizer/arc_control_policy.ts';
+import type {Spec} from '../scripts/v0/types.ts';
+
+const ranker={featureSchema:ARC_PROPOSAL_FEATURE_SCHEMA,featureCount:73,
+  trees:[{left:[1,-1,-1],right:[2,-1,-1],feature:[63,-2,-2],threshold:[0,-2,-2],value:[0,.1,1]}]};
+const base={entry:0,turn:0,exit:0,support:12,bias:0,offset:0};
+it('ranks larger proposal pools with stable ties and optional retained incumbents',()=>{
+  const controls=[{...base,entry:10},{...base,entry:-5},{...base,entry:-10},{...base,entry:-5}];
+  const context=Array(63).fill(0);
+  expect(rankArcControlProposals(context,0,30,controls,2,ranker,{})).toEqual([controls[1],controls[2]]);
+  expect(rankArcControlProposals(context,0,30,controls,2,ranker,{},1)).toEqual([controls[0],controls[1]]);
+  expect(()=>arcProposalQuality(Array(72).fill(0),ranker)).toThrow('feature mismatch');
+});
+
+it('uses the actual bounded long-arc turn timing and float32 traversal',()=>{
+  const encoded=arcProposalControlFeatures({...base,support:100,turnFraction:.02},0,100,{preserveTurnTiming:true});
+  expect(encoded[3]).toBe(.96);expect(encoded[7]).toBe(5/96);
+  const features=Array(73).fill(0);features[63]=1e-50;
+  expect(arcProposalQuality(features,ranker)).toBe(.1);
+});
+
+it('preserves disabled search and validates enabled proposals in the real engine',()=>{
+  const spec:Spec={duration:4,preroll:5,jitter:0,contacts:[.6,1.2,1.8,2.4,3,3.6].map(t=>({t,impact:.4})),axes:{air:()=>.5,speed:()=>.5}};
+  const tree={left:[-1],right:[-1],feature:[-2],threshold:[-2],value:[[0,0,0,.5,0,0,1,.4,0,0]]};
+  const policy={featureSchema:ARC_POLICY_SCHEMA,featureCount:57,trees:[tree,tree],proposalRanker:ranker};
+  const options={budget:40000,samples:32,channel:12,radius:24,bidirectional:true,
+    impactWeight:1,amplitudeWeight:1/3,arrivalWeight:.3,headingWeight:.3,
+    guidance:'clearance' as const,guidanceJoint:true,guidanceSamples:48,responseSamples:46,
+    expressive:true,policySamples:8,controlPolicy:policy};
+  const plain=compileArcMotion(spec,17,options),disabled=compileArcMotion(spec,17,{...options,rankedPolicyPool:0});
+  expect(disabled.track).toEqual(plain.track);expect(disabled.stats).toEqual(plain.stats);
+  const ranked=compileArcMotion(spec,17,{...options,rankedPolicyPool:16});
+  expect(ranked.failure).toBeNull();expect(ranked.report.contacts.every(c=>c.status==='hit')).toBe(true);
+  expect(ranked.report.off_beat_landings).toEqual([]);expect(ranked.stats.sim_frames).toBeLessThanOrEqual(options.budget);
+  expect(ranked.track.lines.every(l=>l.type===0)).toBe(true);
+});
