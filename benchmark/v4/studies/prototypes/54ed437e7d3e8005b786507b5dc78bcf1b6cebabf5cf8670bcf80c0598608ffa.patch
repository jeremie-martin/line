+++ b/scripts/v0/optimizer/arc_proposal_ranker.ts
@@ -0,0 +1,41 @@
+/** Rank proposed controls; feasibility and selection remain physical searches. */
+import {normalizeArcTurnFraction,type ArcMotionControl} from './arc_geometry.ts';
+const clamp=(x:number,a:number,b:number)=>Math.max(a,Math.min(b,x));
+export const ARC_PROPOSAL_FEATURE_SCHEMA='line.arc-proposal-features.v1';
+
+/** Match the construction search's bounds before predicting its measurement. */
+export function arcProposalControlFeatures(control:ArcMotionControl,incoming:number,span:number,
+  options:{bidirectional?:boolean;preserveTurnTiming?:boolean;channel?:number}):number[]{
+  const c={...control,entry:clamp(control.entry,-75,85),turn:clamp(control.turn,-120,options.bidirectional?120:15),
+    exit:clamp(control.exit,-80,85),support:clamp(control.support,2,Math.max(2,span-4)),
+    bias:clamp(control.bias,-2,2),offset:clamp(control.offset,-2,3)};
+  const fraction=c.turnFraction===undefined?Math.min(5,c.support*.5)/c.support:
+    normalizeArcTurnFraction(c.turnFraction,c.support,options.preserveTurnTiming);
+  return [(c.entry-incoming)/30,c.turn/60,(c.exit-incoming)/60,c.support/span,c.bias,c.offset,
+    (c.clearance===undefined?options.channel??12:clamp(c.clearance,6,30))/12,
+    fraction,clamp(c.bend??0,-60,60)/30,clamp(c.guideFlare??0,-16,16)/8];
+}
+
+export function arcProposalQuality(features:number[],model:any):number{
+  if(model.featureSchema!==ARC_PROPOSAL_FEATURE_SCHEMA||model.featureCount!==73||features.length!==73||features.some(v=>!Number.isFinite(v)))throw new Error('arc proposal feature mismatch');
+  const input=features.map(Math.fround);let value=0;
+  for(const tree of model.trees){
+    let n=0;while(tree.left[n]>=0)n=input[tree.feature[n]]<=tree.threshold[n]?tree.left[n]:tree.right[n];
+    value+=tree.value[n];
+  }
+  return value/model.trees.length;
+}
+
+export function rankArcControlProposals(context:number[],incoming:number,span:number,
+  controls:ArcMotionControl[],count:number,model:any,options:any,keep=0):ArcMotionControl[]{
+  if(context.length!==63||!Number.isSafeInteger(count)||count<0||!Number.isSafeInteger(keep)||keep<0)throw new Error('invalid arc proposal ranking request');
+  const retained:ArcMotionControl[]=[],scored:Array<{control:ArcMotionControl;value:number}>=[],seen=new Set<string>();
+  for(let i=0;i<controls.length;i++){
+    const control=controls[i],encoded=arcProposalControlFeatures(control,incoming,span,options),key=JSON.stringify(encoded);
+    if(seen.has(key))continue;seen.add(key);
+    if(i<Math.min(keep,count))retained.push(control);
+    else scored.push({control,value:arcProposalQuality([...context,...encoded],model)});
+  }
+  scored.sort((a,b)=>a.value-b.value);
+  return [...retained,...scored.slice(0,Math.max(0,count-retained.length)).map(row=>row.control)];
+}
diff --git a/tests/arc_proposal_ranker.test.ts b/tests/arc_proposal_ranker.test.ts
new file mode 100644
