@@ -0,0 +1,15 @@
+/** Relative proposals for following arcs. Metadata is invisible to geometry and serialization. */
+import type {ArcMotionControl} from './arc_geometry.ts';
+const continuationTemplates=Symbol('arc continuation templates');
+type AnnotatedControl=ArcMotionControl&{[continuationTemplates]?:number[][]};
+export function arcControlTemplate(v:number[],incoming:number,span:number):ArcMotionControl{
+  if(v.length!==10||v.some(x=>!Number.isFinite(x)))throw new Error('invalid arc continuation template');
+  return {entry:incoming+30*v[0],turn:60*v[1],exit:incoming+60*v[2],support:span*v[3],bias:v[4],offset:v[5],clearance:12*v[6],turnFraction:v[7],bend:30*v[8],guideFlare:8*v[9]};
+}
+export function annotateArcContinuation(control:ArcMotionControl,templates?:number[][]):ArcMotionControl{
+  if(templates?.length)(control as AnnotatedControl)[continuationTemplates]=templates;
+  return control;
+}
+export function arcContinuationTemplates(control:ArcMotionControl):number[][]|undefined{
+  return (control as AnnotatedControl)[continuationTemplates];
+}
