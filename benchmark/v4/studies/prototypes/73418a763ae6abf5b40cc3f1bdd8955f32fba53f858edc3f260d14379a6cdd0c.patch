+
+/** Reuse only a response that predicted the just-measured physical change. */
+export function arcSecantReliable(jacobian:number[][],step:number[],before:number[],after:number[]):boolean{
+  if(jacobian.length!==before.length||after.length!==before.length||jacobian.some(row=>row.length!==step.length))return false;
+  const predicted=jacobian.map(row=>row.reduce((s,v,k)=>s+v*step[k],0));
+  const change=after.map((v,i)=>v-before[i]);
+  const squared=(values:number[])=>values.reduce((s,v)=>s+v*v,0);
+  const old=squared(before),actualDrop=old-squared(after),predictedDrop=old-squared(before.map((v,i)=>v+predicted[i]));
+  if(!Number.isFinite(actualDrop)||!Number.isFinite(predictedDrop)||actualDrop<=1e-12||predictedDrop<=1e-12)return false;
+  const ratio=actualDrop/predictedDrop;
+  return ratio>=.25&&ratio<=4&&squared(change.map((v,i)=>v-predicted[i]))<=.25*Math.max(squared(change),squared(predicted),1e-12);
+}
