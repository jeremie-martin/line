diff --git a/tests/arc_relative_reflow.test.ts b/tests/arc_relative_reflow.test.ts
new file mode 100644
index 00000000..1ded1143
--- /dev/null
+++ b/tests/arc_relative_reflow.test.ts
@@ -0,0 +1,21 @@
+import {expect,it} from 'vitest';
+import {compileArcMotion} from '../scripts/v0/optimizer/arc_motion.ts';
+import type {Spec} from '../scripts/v0/types.ts';
+const spec:Spec={duration:5,preroll:5,jitter:0,contacts:[.6,1.2,1.8,2.4,3,3.6,4.2].map(t=>({t,impact:.4})),axes:{air:()=>.5,speed:()=>.5,amplitude:()=>.2}};
+const options={budget:90000,constructionBudget:35000,samples:80,channel:12,radius:24,bidirectional:true,
+  impactWeight:1,amplitudeWeight:1/3,arrivalMode:'speed',arrivalWeight:.3,headingWeight:.3,authoredHorizon:true,
+  guidance:'clearance' as const,guidanceSamples:24,expressive:true,wholeTrackRefinement:true,
+  refineAttempts:4,refineSamples:24,refineGuidanceSamples:48,refineWidth:3,refineMode:'reflow' as const,refineFollowSamples:6,refineRebuildSamples:16};
+it('keeps physical construction and work identical when relative rebuilding is disabled',()=>{
+  const plain=compileArcMotion(spec,17,options),disabled=compileArcMotion(spec,17,{...options,refineRelativeControls:false});
+  expect(disabled.track).toEqual(plain.track);expect(disabled.stats).toEqual(plain.stats);
+});
+it('retains measured incoming angles and validates complete relative reflows inside the shared budget',()=>{
+  const result=compileArcMotion(spec,17,{...options,refineRelativeControls:true});
+  expect(result.rows.every(r=>Number.isFinite(r.incoming))).toBe(true);
+  expect(result.refinementStats.counts.proposals).toBeGreaterThan(0);
+  expect(result.refinementStats.counts.complete).toBeGreaterThan(0);
+  expect(result.refinementStats.finalLoss).toBeLessThanOrEqual(result.refinementStats.initialLoss);
+  expect(result.stats.sim_frames).toBeLessThanOrEqual(options.budget);expect(result.failure).toBeNull();
+  expect(result.report.contacts.every(c=>c.status==='hit')).toBe(true);expect(result.track.lines.every(l=>l.type===0)).toBe(true);
+});
