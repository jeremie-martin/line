diff --git a/tests/arc_refinement_objective.test.ts b/tests/arc_refinement_objective.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/arc_refinement_objective.test.ts
@@ -0,0 +1,22 @@
+import {expect,it} from 'vitest';
+import {compileArcMotion} from '../scripts/v0/optimizer/arc_motion.ts';
+import type {Spec} from '../scripts/v0/types.ts';
+
+it('changes only refinement and retains a physically validated complete incumbent',()=>{
+  const spec:Spec={duration:5,preroll:5,jitter:0,contacts:[.6,1.2,1.8,2.4,3,3.6,4.2].map(t=>({t,impact:.4})),axes:{air:()=>.5,speed:()=>.5,amplitude:()=>.2}};
+  const options={budget:70000,constructionBudget:35000,samples:80,channel:12,radius:24,bidirectional:true,
+    impactWeight:1,amplitudeWeight:1/3,arrivalWeight:.3,headingWeight:.3,authoredHorizon:true,
+    guidance:'clearance' as const,guidanceSamples:48,responseSamples:46,expressive:true,
+    wholeTrackRefinement:true,amplitudeOverflow:'raw' as const};
+  const plain=compileArcMotion(spec,17,options);
+  const toggled=compileArcMotion(spec,17,{...options,refineTimeObjective:true});
+  expect(toggled.track).toEqual(plain.track);expect(toggled.stats).toEqual(plain.stats);
+  const refined=compileArcMotion(spec,17,{...options,refineTimeObjective:true,
+    refineAttempts:6,refineSamples:24,refineGuidanceSamples:48,refineWidth:3,refineMode:'reflow',refineFollowSamples:12});
+  expect(refined.failure).toBeNull();expect(refined.report.contacts.every(c=>c.status==='hit')).toBe(true);
+  expect(refined.report.off_beat_landings).toEqual([]);
+  expect(refined.stats.sim_frames).toBeLessThanOrEqual(options.budget);
+  expect(refined.refinementStats.counts.proposals).toBeGreaterThan(0);
+  expect(refined.refinementStats.finalLoss).toBeLessThanOrEqual(refined.refinementStats.initialLoss);
+  expect(refined.track.lines.every(l=>l.type===0)).toBe(true);
+});
