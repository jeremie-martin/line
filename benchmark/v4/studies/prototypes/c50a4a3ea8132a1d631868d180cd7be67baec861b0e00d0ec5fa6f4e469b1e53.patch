+import {expect,it} from 'vitest';
+import {arcControlProposals,ARC_POLICY_SCHEMA} from '../scripts/v0/optimizer/arc_control_policy.ts';
+import {compileArcMotion} from '../scripts/v0/optimizer/arc_motion.ts';
+import type {Spec} from '../scripts/v0/types.ts';
+const schema='line.arc-context-control-policy-features.v1';
+const leaf=(v:number[])=>({left:[-1],right:[-1],feature:[-2],threshold:[-2],value:[v]});
+it('passes declared feature prefixes to mixed models and rejects mismatches',()=>{
+  const v=Array(10).fill(.1),base={featureSchema:ARC_POLICY_SCHEMA,featureCount:57,trees:[leaf(v),leaf(v)]};
+  const split={left:[1,-1,-1],right:[2,-1,-1],feature:[60,-2,-2],threshold:[.5,-2,-2],value:[v,v,Array(10).fill(.2)]};
+  const contextual={featureSchema:schema,featureCount:63,trees:[split,split]},mix={featureSchema:schema,featureCount:63,models:[base,contextual]};
+  const f=Array(63).fill(0);f[60]=1;
+  const result=arcControlProposals(f,20,30,mix,2);
+  expect(result[0]).toEqual(arcControlProposals(f.slice(0,57),20,30,base,1)[0]);expect(result[1].entry).toBe(26);
+  expect(()=>arcControlProposals(f.slice(0,57),20,30,mix,2)).toThrow('feature mismatch');
+  expect(()=>arcControlProposals(f,20,30,{...mix,featureSchema:'invalid'},2)).toThrow('feature mismatch');
+});
+it('supplies contextual proposals during simulation and exactly preserves a wrapped legacy policy',()=>{
+  const spec:Spec={duration:4,preroll:5,jitter:0,contacts:[.6,1.2,1.8,2.4,3,3.6].map(t=>({t,impact:.4})),axes:{air:()=>.5,speed:()=>.5}};
+  const tree=leaf([0,0,0,.5,0,0,1,.4,0,0]),base={featureSchema:ARC_POLICY_SCHEMA,featureCount:57,trees:[tree,tree]};
+  const options={budget:40000,samples:32,channel:12,radius:24,bidirectional:true,impactWeight:1,amplitudeWeight:1/3,
+    arrivalWeight:.3,headingWeight:.3,guidance:'clearance' as const,guidanceJoint:true,guidanceSamples:48,responseSamples:46,
+    expressive:true,policySamples:8,completeBoundary:true,controlPolicy:base};
+  const legacy=compileArcMotion(spec,17,options),wrapped=compileArcMotion(spec,17,{...options,controlPolicy:{featureSchema:schema,featureCount:63,models:[base]}});
+  expect(wrapped.track).toEqual(legacy.track);expect(wrapped.stats).toEqual(legacy.stats);
+  const split={left:[1,-1,-1],right:[2,-1,-1],feature:[60,-2,-2],threshold:[.5,-2,-2],value:[[],tree.value[0],[0,.1,0,.6,0,0,1,.4,0,0]]};
+  const actual=compileArcMotion(spec,17,{...options,controlPolicy:{featureSchema:schema,featureCount:63,trees:[split,split]}});
+  expect(actual.failure).toBeNull();expect(actual.report.contacts.every(c=>c.status==='hit')).toBe(true);
+  expect(actual.stats.sim_frames).toBeLessThanOrEqual(options.budget);expect(actual.track.lines.every(l=>l.type===0)).toBe(true);
+});
