@@ -0,0 +1,27 @@
+import {expect,it} from 'vitest';
+import {arcBoundedDifference} from '../scripts/v0/optimizer/arc_response.ts';
+import {compileArcMotion} from '../scripts/v0/optimizer/arc_motion.ts';
+import type {Spec} from '../scripts/v0/types.ts';
+it('recovers derivatives from unequal steps and surviving one-sided probes',()=>{
+  const f=(x:number)=>[2+3*x+4*x*x,5-7*x+2*x*x];
+  const both=arcBoundedDifference(f(0),f(.3),f(-1),.3,-1);
+  expect(both[0]).toBeCloseTo(3,12);expect(both[1]).toBeCloseTo(-7,12);
+  expect(arcBoundedDifference([2],[2],[1],0,-.5)).toEqual([2]);
+  expect(arcBoundedDifference([2],null,[1],0,-.5)).toEqual([2]);
+  expect(arcBoundedDifference([2],[3],null,.5,0)).toEqual([2]);
+  expect(arcBoundedDifference([2],[2],[2],0,0)).toEqual([0]);
+});
+it('preserves tracks when measuring bounds and validates the enabled search under its frame cap',()=>{
+  const spec:Spec={duration:4,preroll:5,jitter:0,contacts:[.6,1.2,1.8,2.4,3,3.6].map(t=>({t,impact:.4})),axes:{air:()=>.5,speed:()=>.5}};
+  const options={budget:40000,samples:32,channel:12,radius:24,bidirectional:true,
+    impactWeight:1,amplitudeWeight:1/3,arrivalWeight:.3,headingWeight:.3,
+    guidance:'clearance' as const,guidanceJoint:true,guidanceSamples:92,responseSamples:92,
+    expressive:true,memoCandidates:true,reuseEvaluations:true,completeBoundary:true};
+  const plain=compileArcMotion(spec,17,options),measured=compileArcMotion(spec,17,{...options,collectResponseBounds:true});
+  expect(measured.track).toEqual(plain.track);expect(measured.stats).toEqual(plain.stats);
+  expect(measured.responseBounds!.dimensions).toBeGreaterThan(0);
+  expect(measured.responseBounds!.limitedProbes).toBeLessThanOrEqual(measured.responseBounds!.validProbes);
+  const enabled=compileArcMotion(spec,17,{...options,responseBoundAware:true});
+  expect(enabled.failure).toBeNull();expect(enabled.report.contacts.every(c=>c.status==='hit')).toBe(true);
+  expect(enabled.track.lines.every(l=>l.type===0)).toBe(true);expect(enabled.stats.sim_frames).toBeLessThanOrEqual(options.budget);
+});
