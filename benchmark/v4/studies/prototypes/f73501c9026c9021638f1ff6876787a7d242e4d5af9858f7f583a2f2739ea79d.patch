 /** Damped local response step in normalized curve-control coordinates. */
+export function arcBoundedDifference(origin:number[],plus:number[]|null,minus:number[]|null,positiveStep:number,negativeStep:number):number[]{
+  const a=plus&&Math.abs(positiveStep)>1e-9?positiveStep:0;
+  const b=minus&&Math.abs(negativeStep)>1e-9?negativeStep:0;
+  return origin.map((value,r)=>{
+    if(a&&b&&Math.abs(a-b)>1e-9){
+      // Derivative at the origin of the quadratic through unequal probes.
+      return ((plus![r]-value)/a*(-b)+(minus![r]-value)/b*a)/(a-b);
+    }
+    return a?(plus![r]-value)/a:b?(minus![r]-value)/b:0;
+  });
+}
