diff --git a/tests/arc_forward_response.test.ts b/tests/arc_forward_response.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/arc_forward_response.test.ts
@@ -0,0 +1,24 @@
+import {expect,it} from 'vitest';
+import {compileArcMotion} from '../scripts/v0/optimizer/arc_motion.ts';
+import {compileArcMotion as reference} from '/home/wyss/line-worktrees/arc-940-lazy/scripts/v0/optimizer/arc_motion.ts';
+import type {Spec} from '../scripts/v0/types.ts';
+const spec:Spec={duration:4,preroll:5,jitter:0,contacts:[.6,1.2,1.8,2.4,3,3.6].map(t=>({t,impact:.4})),axes:{air:()=>.5,speed:()=>.5}};
+const options={budget:40000,samples:32,channel:12,radius:24,bidirectional:true,impactWeight:1,amplitudeWeight:1/3,
+  arrivalWeight:.3,headingWeight:.3,guidance:'clearance' as const,guidanceJoint:true,guidanceSamples:92,responseSamples:92,
+  expressive:true,completeBoundary:true};
+it('preserves the unchanged physical search and work when disabled',()=>{
+  const a=reference(spec,17,options),b=compileArcMotion(spec,17,options);
+  expect(b.track).toEqual(a.track);expect(b.stats).toEqual(a.stats);expect(b.responseProbeStats.rounds).toBe(0);
+});
+it('uses fewer probes per complete measured response and preserves physical validity',()=>{
+  const r=compileArcMotion(spec,17,{...options,forwardResponse:true});
+  expect(r.failure).toBeNull();expect(r.report.contacts.every(c=>c.status==='hit')).toBe(true);
+  expect(r.track.lines.every(l=>l.type===0)).toBe(true);expect(r.stats.sim_frames).toBeLessThanOrEqual(options.budget);
+  const s=r.responseProbeStats;expect(s.rounds).toBeGreaterThan(10);expect(s.probes).toBeLessThan(s.rounds*20);
+  expect(s.probes).toBe(s.rounds*10+s.fallbacks);
+});
+it('keeps actual work below the hard ceiling when an enabled probe is interrupted',()=>{
+  const r=compileArcMotion(spec,17,{...options,budget:6000,forwardResponse:true});
+  expect(r.stats.sim_frames).toBeLessThanOrEqual(6000);expect(r.searchBudgetExhausted).toBe(true);
+  expect(r.track.lines.every(l=>l.type===0)).toBe(true);
+});
