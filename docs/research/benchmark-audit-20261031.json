   "float12": "gap >=1.2 s (high-air: air ask >=0.7)",
   "drop": "gap >=1.0 s ending in an ask >=0.8",
   "intenseWindow": "4 s window (1 s steps) with >=2.5 landings/s, mean ask >=0.5, speed ask >=0.6 mid-window",
   "note": "Thresholds are the auditor's, not owner-validated."
  }
 },
