{
 "schema": "line.speed-evidence.v1",
 "date": "2026-10-30",
 "question": "After the crashed-candidate stop, physics stepping is a minor part of a candidate. Where does the rest of a candidate's CPU go, and which of it can be removed with identical tracks, scores and frame counts?",
 "protocol": {
  "cpu": "Process CPU (user+system) of one compileHandoff per process, LR_ENGINE=wasm, as docs/research/speed-20261029.json: each pair runs both arms concurrently with alternating launch order; the five cases run side by side, and several pair sets ran at the same time on the shared 64-core host, so absolute seconds vary with load and only paired ratios are compared. Every pair asserts identical track hash and physical-frame count.",
  "profiles": "V8 --cpu-prof at 1 ms over the main thread, with an unstripped build of the same compiler-engine sources so WASM functions are named. Each sample is attributed to the innermost enclosing function that names a part (breakdown below). The main thread is about 75% of process CPU; the rest is V8 background compilation and GC helper threads. Before and after profiles ran concurrently.",
  "parts": {
   "line registration and undo (native addLine)": "LineRiderEngine.addLine: registering the candidate's lines in the collision grid, invalidating cached frames they intersect, and (on the next addLine to the same parent) undoing the previous sibling's lines",
   "geometry construction (motionArc)": "buildGeometry and motionArc (polyline and guide construction in JS)",
   "construction inspection": "inspectConstructionWindow (layout fulfilment, guide attribution)",
   "physics stepping": "boundThroughMetered and getRiderMetered (native stepping of the replay)",
   "detection": "raw trajectory extraction and resumable event detection",
   "impact observation and checks": "traceCandidate itself: impact account observation and validity checks",
   "objective": "measureObjective and recordCandidate",
   "outside candidate evaluation": "proposal generation, local search bookkeeping, selection, final replay"
  },
  "cases": "luna/amor/tiki/amour = production songs ~3001 resolved by tools/eval/inputs.ts at jolt -15 ms, productionBudget, line.strike.v3; long = benchmark/v4 stretch_supported_speed_change seed 101 (93 s), as in speed-20261029."
 },
 "commits": {
  "base": "458fe8af",
  "A": "attribute only contacted guide lines",
  "B": "motionArc step helpers at module scope",
  "C": "binary search in collision-grid buckets",
  "D": "one native version per addLine batch",
  "E (dropped)": "line id stored beside each grid entry: paired ratios 0.99-1.02, not kept"
 },
