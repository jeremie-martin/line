{
  "name": "line",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Line Rider tracks composed automatically from music: seeded arrangements of normal-line geometry, judged by native physics.",
  "scripts": {
    "produce": "LR_ENGINE=wasm node --import tsx scripts/produce/automatic.ts",
    "library": "LR_ENGINE=wasm node --import tsx scripts/produce/production_library.ts",
    "render": "LR_ENGINE=wasm node --import tsx scripts/produce/render_repertoire.ts",
    "serve": "node --import tsx scripts/serve.ts",
    "sentinel": "LR_ENGINE=wasm node --import tsx scripts/benchmark/v6.ts eval",
    "parity": "LR_ENGINE=wasm node --import tsx tools/parity/parity.ts compile",
    "parity:judge": "LR_ENGINE=wasm node --import tsx tools/parity/parity.ts judge",
    "reach": "node tools/deps/reach.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "verify:engine": "node --max-old-space-size=8192 --import tsx scripts/v0/bench/sim_trace.ts",
    "gallery:renderer": "node scripts/gallery/build_renderer.mjs",
    "build:wasm": "cargo build --release --target wasm32-unknown-unknown --manifest-path engine-rs/Cargo.toml && wasm-opt --enable-bulk-memory --enable-nontrapping-float-to-int --enable-sign-ext -O3 engine-rs/target/wasm32-unknown-unknown/release/lr_engine.wasm -o engine-rs/target/wasm32-unknown-unknown/release/lr_engine.wasm",
    "measure": "node --import tsx tools/measure/observe.ts && node --import tsx tools/measure/measures.ts",
    "labels:study": "node --import tsx tools/measure/label_study.ts",
    "labels:analyze": "node --import tsx tools/measure/analyze_labels.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "0.28.0",
    "lr-core": "^0.8.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.7",
    "webcrack": "^2.16.0"
  },
  "dependencies": {
    "@openai/codex": "^0.144.0",
    "playwright": "^1.49.0",
    "uplot": "^1.6.32"
  }
}
