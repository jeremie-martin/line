{
  "name": "line",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Line Rider tracks composed automatically from music: seeded arrangements of normal-line geometry, judged by native physics.",
  "scripts": {
    "produce": "LR_ENGINE=wasm node scripts/produce/automatic.ts",
    "library": "LR_ENGINE=wasm node scripts/produce/production_library.ts",
    "render": "LR_ENGINE=wasm node scripts/produce/render_repertoire.ts",
    "serve": "node scripts/serve.ts",
    "parity": "LR_ENGINE=wasm node tools/parity/parity.ts compile",
    "parity:judge": "LR_ENGINE=wasm node tools/parity/parity.ts judge",
    "reach": "node tools/deps/reach.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "verify:engine": "node tools/parity/engine.ts",
    "verify:engine:trace": "node --max-old-space-size=8192 scripts/v0/bench/sim_trace.ts",
    "bench:engine": "node tools/measure/engine.ts",
    "perf:engine": "node tools/measure/engine_ab.ts",
    "perf:profile": "LR_ENGINE=wasm node tools/measure/profile.ts",
    "build:native": "node tools/measure/build_native_engine.mjs",
    "gallery:renderer": "node scripts/gallery/build_renderer.mjs",
    "build:wasm": "cargo build --release --target wasm32-unknown-unknown --manifest-path engine-rs/Cargo.toml && wasm-opt --enable-bulk-memory --enable-nontrapping-float-to-int --enable-sign-ext -O3 engine-rs/target/wasm32-unknown-unknown/release/lr_engine.wasm -o engine-rs/target/wasm32-unknown-unknown/release/lr_engine.wasm",
    "labels:analyze": "node tools/measure/analyze_labels.ts",
    "eval": "node tools/eval/eval.ts run",
    "eval:report": "node tools/eval/eval.ts report",
    "compare": "node tools/eval/compare.ts",
    "check:physics": "node tools/parity/engine_quick.ts",
    "check": "npm run typecheck && npm run reach && npm test && cargo test --locked --manifest-path scripts/lib/native_motion/Cargo.toml --target-dir generated/native-motion-tests && npm run check:physics && npm run verify:engine && npm run parity && npm run parity:judge"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "0.28.0",
    "lr-core": "^0.8.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "playwright": "^1.49.0"
  },
  "engines": {
    "node": "22.22.2"
  }
}
